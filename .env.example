NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEV_USER_EMAIL=demo@vestintel.local

# Backend URL used by Next.js rewrites (server-side proxy)
# Locally: leave unset (defaults to http://localhost:8000)
# Production (Netlify): set to your deployed FastAPI URL, e.g. https://vestintel-api.railway.app
BACKEND_URL=http://localhost:8000
