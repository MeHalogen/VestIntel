# ─── Frontend (Next.js) ───────────────────────────────────────────────
# URL of the FastAPI backend — change to your production domain when deploying
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email used for the X-User-Email auth header in dev/demo mode
# In production, replace this with the authenticated user's email
NEXT_PUBLIC_DEV_USER_EMAIL=demo@vestintel.local

# ─── Backend (FastAPI) ────────────────────────────────────────────────
# OpenAI API key for AI Copilot & analysis (optional — falls back to local math)
OPENAI_API_KEY=

# TwelveData API key for global stock quotes
TWELVEDATA_API_KEY=

# Postgres connection string
DATABASE_URL=postgresql://vestintel:vestintel@localhost:5432/vestintel

# Redis connection (use redis://localhost:6380 if running Docker Redis on host port 6380)
REDIS_URL=redis://localhost:6379

# JWT / session secret
SECRET_KEY=change-me-to-a-random-secret
