# Database
DATABASE_URL=postgresql://vestintel:password@localhost:5432/vestintel

# Redis
REDIS_URL=redis://localhost:6379

# API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here
TWELVEDATA_API_KEY=your_twelvedata_key_here
NEWS_API_KEY=your_newsapi_key_here

# Market data ingestion
INGEST_WATCHLIST=AAPL,NVDA,MSFT,TSLA,AMZN,META,GOOGL,RELIANCE.NSE,TCS.NSE,INFY.NSE,HDFCBANK.NSE,ITC.NSE
PRICE_CACHE_TTL_SECONDS=60
DISABLE_WORKERS=false

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3100

# Cache TTL (seconds)
CACHE_TTL=300
